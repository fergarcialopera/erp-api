# Plantilla de variables de entorno.
#
# Local:      cp .env.example .env  →  make up
#             (docker-compose.yml + docker-compose.dev.yml, profile dev para mailpit)
# Producción: cp .env.example .env.production  →  deploy con docker-compose.prod.yml
#
# APP_ENV controla el modo de la aplicación y el Makefile (local | prod).
# En producción usar: APP_ENV=prod, APP_DEBUG=false y credenciales seguras.

APP_ENV=local
APP_DEBUG=true
APP_NAME="ERP Clinic Stock"

# URL pública del API (enlaces, recovery, OpenAPI, health).
# Local: http://localhost:8080
# Prod: https://<dominio> sin puerto (mismo origen que el SPA, ej. https://erp.midominio.com)
APP_URL=http://localhost:8080
APP_PUBLIC_URL=http://localhost:8080

# Origen del SPA: enlaces en correos de recuperación y origen permitido en CORS (nginx dev).
# Debe coincidir con la URL donde corre el frontend en local (dev server en :8081).
# Local: http://localhost:8081  |  Prod: https://<dominio> sin puerto (ej. https://erp.midominio.com)
FRONTEND_URL=http://localhost:8081

# Prod: dominio público para TLS (server_name de nginx y ruta del certificado en
# /etc/letsencrypt/live/<SERVER_NAME>/). Requiere certificado emitido en el host (README §10).
# SERVER_NAME=erp.midominio.com
# Prod: webroot del host donde certbot deja el challenge ACME (por defecto /var/www/certbot).
# CERTBOT_WEBROOT=/var/www/certbot

# Prod: directorio del repo frontend en el VPS (hermano de erp-api por defecto).
# FRONTEND_DIR=/root/erp-frontend
# Prod: ruta al build (auto: FRONTEND_DIR/dist, luego FRONTEND_DIR). Montado en erp-nginx.
# FRONTEND_DIST_PATH=/root/erp-frontend/dist

DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=erp
DB_USERNAME=erp
DB_PASSWORD=erp

REDIS_HOST=redis
REDIS_PORT=6379

AUTH_USER_TTL=1800
AUTH_CLINIC_TTL=28800
RECOVERY_TTL_MINUTES=60

# Correo. Local: Mailpit. Prod: SMTP real (MAIL_HOST, MAIL_PORT, credenciales del proveedor).
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM=noreply@erp.local
MAIL_FROM_NAME="ERP Clinic"

# MQTT (Mosquitto). Si MQTT_HOST está vacío o MQTT_DISABLED=true, el backend no conecta (no-op).
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=erp_mqtt
MQTT_PASSWORD=cambiar_esta_clave_mqtt
MQTT_CLIENT_ID=erp-backend
MQTT_DISABLED=false

# Plantilla de variables de entorno.
#
# Local:      cp .env.example .env
# Producción: cp .env.example .env.production
#
# APP_ENV controla el modo de la aplicación y el Makefile (local | prod).
# En producción usar: APP_ENV=prod, APP_DEBUG=false y credenciales seguras.

APP_ENV=local
APP_DEBUG=true
APP_NAME="ERP Clinic Stock"

# URL pública del API (enlaces, recovery, OpenAPI, health, base URL del frontend en prod).
# Local: http://localhost:8080
# Prod: http://<IP-o-dominio>:8080  (ej. http://212.227.145.0:8080)
APP_URL=http://localhost:8080
APP_PUBLIC_URL=http://localhost:8080

# Origen del frontend (enlaces en correos de recuperación; debe coincidir con CORS en nginx).
# Local: http://localhost:3000 — ver $cors_allow_origin en docker/nginx/default.conf
# Prod: http://<IP-o-dominio> sin puerto — ver $cors_allow_origin en docker/nginx/prod.conf
FRONTEND_URL=http://localhost:3000

DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=erp
DB_USERNAME=erp
DB_PASSWORD=erp

REDIS_HOST=redis
REDIS_PORT=6379

AUTH_USER_TTL=1800
AUTH_CLINIC_TTL=28800
RECOVERY_TTL_MINUTES=60

# Correo. Local: Mailpit. Prod: SMTP real (MAIL_HOST, MAIL_PORT, credenciales del proveedor).
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM=noreply@erp.local
MAIL_FROM_NAME="ERP Clinic"

# MQTT (Mosquitto). Si MQTT_HOST está vacío o MQTT_DISABLED=true, el backend no conecta (no-op).
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=erp_mqtt
MQTT_PASSWORD=cambiar_esta_clave_mqtt
MQTT_CLIENT_ID=erp-backend
MQTT_DISABLED=false

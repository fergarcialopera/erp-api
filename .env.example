# Plantilla de variables de entorno.
#
# Local:      cp .env.example .env  →  make up
#             (docker-compose.yml + docker-compose.dev.yml, profile dev para mailpit)
# Producción: cp .env.example .env.production  →  deploy con docker-compose.prod.yml
#
# APP_ENV controla el modo de la aplicación y el Makefile (local | prod).
# En producción usar: APP_ENV=prod, APP_DEBUG=false y credenciales seguras.

APP_ENV=local
APP_DEBUG=true
APP_NAME="ERP Clinic Stock"

# URL pública del API (enlaces, recovery, OpenAPI, health).
# Local: http://localhost:8080
# Prod: http://<IP-o-dominio> sin puerto (mismo origen que el SPA, ej. http://212.227.145.0)
APP_URL=http://localhost:8080
APP_PUBLIC_URL=http://localhost:8080

# Origen del SPA (enlaces en correos de recuperación). Repo y despliegue del frontend: independiente.
# Local: http://localhost:3000  |  Prod: http://<IP-o-dominio> sin puerto (ej. http://212.227.145.0)
FRONTEND_URL=http://localhost:3000

# Prod: ruta al dist del frontend en el VPS (montado en erp-nginx como /var/www/frontend).
# FRONTEND_DIST_PATH=/root/erp-frontend/dist

DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=erp
DB_USERNAME=erp
DB_PASSWORD=erp

REDIS_HOST=redis
REDIS_PORT=6379

AUTH_USER_TTL=1800
AUTH_CLINIC_TTL=28800
RECOVERY_TTL_MINUTES=60

# Correo. Local: Mailpit. Prod: SMTP real (MAIL_HOST, MAIL_PORT, credenciales del proveedor).
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM=noreply@erp.local
MAIL_FROM_NAME="ERP Clinic"

# MQTT (Mosquitto). Si MQTT_HOST está vacío o MQTT_DISABLED=true, el backend no conecta (no-op).
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=erp_mqtt
MQTT_PASSWORD=cambiar_esta_clave_mqtt
MQTT_CLIENT_ID=erp-backend
MQTT_DISABLED=false

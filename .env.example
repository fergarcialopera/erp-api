APP_ENV=local
APP_DEBUG=true
APP_NAME="ERP Clinic Stock"
APP_URL=http://localhost:8080

DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=erp
DB_USERNAME=erp
DB_PASSWORD=erp

# Tests de integración: usar docker-compose.test.yml (APP_ENV=testing, DB erp_test).
# Ver README sección 9. No ejecutar phpunit de integración contra DB_DATABASE=erp.

REDIS_HOST=redis
REDIS_PORT=6379

# MQTT (Mosquitto) — publicación de comandos de cerradura desde el backend (lockers/{deviceId}/cmd).
# Si MQTT_HOST está vacío o MQTT_DISABLED=true, el backend no conecta al broker (no-op; útil en tests).
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=erp_mqtt
MQTT_PASSWORD=cambiar_esta_clave_mqtt
MQTT_CLIENT_ID=erp-backend
MQTT_DISABLED=false

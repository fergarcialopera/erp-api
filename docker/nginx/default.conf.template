# Desarrollo: plantilla procesada por envsubst en el arranque del contenedor nginx.
# La variable de entorno FRONTEND_URL (definida en .env) se sustituye en el origen CORS;
# el resto de variables ($uri, $cors_allow_origin, ...) son de nginx y no se tocan.
server {
    listen 80;
    server_name localhost;
    root /var/www/html/public;
    index index.php;

    # Alineado con product-imports (5 MB) y margen multipart.
    client_max_body_size 5m;

    set $cors_allow_origin "${FRONTEND_URL}";

    location /uploads/ {
        alias /var/www/html/storage/uploads/;
    }

    location / {
        include /etc/nginx/snippets/cors.conf;
        try_files $uri /index.php$is_args$args;
    }

    location ~ \.php$ {
        include /etc/nginx/snippets/cors.conf;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_pass php:9000;
        # Análisis síncrono de CSV grandes (product-imports).
        fastcgi_read_timeout 300s;
    }
}

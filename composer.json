{
  "name": "clinic/erp-backend",
  "description": "ERP backend for clinic stock management",
  "type": "project",
  "require": {
    "php": "^8.4",
    "nikic/fast-route": "^1.3",
    "monolog/monolog": "^3.7",
    "predis/predis": "^2.2",
    "vlucas/phpdotenv": "^5.6",
    "symfony/uid": "^7.1",
    "php-mqtt/client": "^2.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.4"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:docker:up": "docker compose -f docker-compose.yml -f docker-compose.test.yml up -d --force-recreate php",
    "test:docker:restore": "docker compose -f docker-compose.yml up -d --force-recreate php",
    "test:docker": "php bin/run-tests.php",
    "test:docker:ps1": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-tests-docker.ps1",
    "test:docker:sh": "sh scripts/run-tests-docker.sh",
    "db:migrate": "php bin/db.php migrate",
    "db:seed": "php bin/db.php seed",
    "db:status": "php bin/db.php status"
  }
}
